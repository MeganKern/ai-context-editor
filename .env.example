# Copy to .env and adjust as needed. Every value here has a sensible default,
# so the app runs with no .env at all.

# Where the server listens.
API_PORT=3710
API_HOST=127.0.0.1

# Database backend: "pglite" (embedded, no setup — the default experience) or
# "postgres" (connect to your own server with the standard PG* variables).
DB_BACKEND=pglite
DB_NAME=desk

# With DB_BACKEND=postgres, the usual libpq variables apply:
# PGHOST=localhost
# PGPORT=5432
# PGUSER=postgres
# PGPASSWORD=
# PGLITE_DATA_DIR=   # with pglite: a folder to persist to; unset keeps it in memory

# Where agent runs are rooted on this computer.
WORKSPACES_ROOT=~/.thedesk/workspaces

# Agents run Claude Code on this computer. Off unless set to 1, and it also needs
# the Claude Code CLI installed and on PATH.
DESK_AGENTS=0
